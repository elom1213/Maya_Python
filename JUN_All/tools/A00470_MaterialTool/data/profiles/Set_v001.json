{
  "name": "Set_v001",
  "description": "Costume set materials : MT_MANU_CH_<character>_<set>_<part>_<extra...>",
  "separator": "_",
  "pattern": "MT_MANU_CH_{character}_{set}_{part}_{extra...}",
  "tokens": [
    {
      "role": "prefix",
      "type": "literal",
      "value": "MT"
    },
    {
      "role": "vendor",
      "type": "literal",
      "value": "MANU"
    },
    {
      "role": "category",
      "type": "literal",
      "value": "CH"
    },
    {
      "role": "character",
      "type": "enum",
      "values": ["CHN", "DHA", "LUN", "SIN", "TBM"]
    },
    {
      "role": "set",
      "type": "pattern",
      "prefix": "Set",
      "digits": 3
    },
    {
      "role": "part",
      "type": "enum",
      "values": ["Body", "Hair", "Top", "Pants", "Shoes", "Accessory"]
    },
    {
      "role": "extra",
      "type": "any",
      "repeat": true,
      "optional": true
    }
  ],
  "checks": {
    "trailing_digit": true
  }
}
